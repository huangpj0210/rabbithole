{
  "name": "rabbithole-console",
  "version": "0.3.0",
  "private": true,
  "description": "rabbithole 管理控制台(基于 ant-design-admin-v6 模板,Umi Max + antd v6 + ProComponents)",
  "license": "MIT",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "cross-env REACT_APP_ENV=dev UMI_ENV=dev max dev",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && max build && node clean-maps.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "max setup",
    "preview": "max preview --port 8000"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/pro-components": "^3.1.0-0",
    "@tanstack/react-query": "5.104.1",
    "antd": "^6.1.3",
    "antd-style": "^3.7.0",
    "axios": "1.20.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "rc-util": "^5.44.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "3.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@umijs/max": "^4.3.24",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "umi-presets-pro": "^2.0.3"
  }
}
