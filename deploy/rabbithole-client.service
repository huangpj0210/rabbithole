[Unit]
Description=rabbithole client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rabbithole
Group=rabbithole
ExecStart=/usr/local/bin/rh-client --config /etc/rabbithole/client.toml
Restart=always
RestartSec=3
# 需内核 fs.nr_open >= 1000000(默认 1048576)
LimitNOFILE=1000000
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
